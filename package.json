{
  "name": "hb-lib-tools",
  "description": "homebridge-lib Command-Line Tools`",
  "author": "Erik Baauw",
  "maintainers": [
    "ebaauw"
  ],
  "license": "Apache-2.0",
  "version": "3.0.11x",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "files": [
    "index.js",
    "dist",
    "cli"
  ],
  "bin": {
    "hap": "cli/hap.js",
    "json": "cli/json.js",
    "sysinfo": "cli/sysinfo.js",
    "upnp": "cli/upnp.js"
  },
  "engines": {
    "node": "24.20.0||^24||^22"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "chalk": "^6.0.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/semver": "^7.8.0",
    "eslint": "^10.9.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon",
    "prepare": "mocha && rm -rf out && jsdoc -c jsdoc.json",
    "test": "mocha"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebaauw/hb-lib-tools.git"
  },
  "bugs": {
    "url": "https://github.com/ebaauw/hb-lib-tools/issues"
  },
  "homepage": "https://github.com/ebaauw/hb-lib-tools#readme",
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
