{
  "name": "hb-lib-tools",
  "description": "homebridge-lib Command-Line Tools",
  "author": "Erik Baauw",
  "maintainers": [
    "ebaauw"
  ],
  "license": "Apache-2.0",
  "version": "4.0.0-1",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "files": [
    "dist",
    "cli"
  ],
  "bin": {
    "hap": "cli/hap.js",
    "json": "cli/json.js",
    "sysinfo": "cli/sysinfo.js",
    "upnp": "cli/upnp.js"
  },
  "engines": {
    "node": "24.20.0||^24||^22"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "chalk": "^6.0.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chalk": "^2.2.4",
    "@types/node": "^22.20.2",
    "@types/semver": "^7.8.0",
    "eslint-config-love": "^156.0.0",
    "typescript-eslint": "^8.70.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "doc": "rm -rf doc && typedoc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "prepare": "npm run lint && npm run build && npm run doc && npm run test",
    "test": "mocha"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebaauw/hb-lib-tools.git"
  },
  "bugs": {
    "url": "https://github.com/ebaauw/hb-lib-tools/issues"
  },
  "homepage": "https://github.com/ebaauw/hb-lib-tools#readme"
}
